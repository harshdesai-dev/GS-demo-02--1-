# GrowthSathi Package 02 — Client Configuration

# Final client-owned HTTPS domain. Required only when enabling search indexing.
VITE_SITE_URL=""

# Set to true only after the client approves the final domain and all demo content is replaced.
# The build then emits an absolute sitemap and permits search indexing.
VITE_INDEXING_ENABLED="false"

# Client-confirmed WhatsApp Click-to-Chat number in international digits only.
# Example: 919876543210
VITE_WHATSAPP_NUMBER=""

# Optional client-owned GA4 Measurement ID. Analytics remains disabled until consent is granted.
VITE_GA4_MEASUREMENT_ID=""
